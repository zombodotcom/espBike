# Defaults applied on first build (idf.py reconcile -> sdkconfig).
# Bluetooth: NimBLE host only, Bluedroid disabled to save flash/RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# NimBLE only needs to be a peripheral (we advertise + serve GATT).
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Single connection is plenty (one phone).
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Keep logs readable during protocol bring-up.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
